# CarbonTrace: copy to .env and replace the password and JWT secret.
# Default setup: Docker backend, PostgreSQL and Mailpit; Vite on port 5173.
# Never commit .env. See docs/setup.md for installation and real email delivery.

ENVIRONMENT=development

# Database credentials. Docker Compose builds DATABASE_URL from these values.
POSTGRES_USER=carbontrace
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=carbontrace

# Generate a random secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Browser URL used in verification and invitation emails.
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local email capture: http://localhost:8025. Mailpit does not send external mail.
# For real delivery, replace these with your SMTP provider's settings.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="CarbonTrace <noreply@carbontrace.local>"
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false

# Optional overrides (defaults shown):
# POSTGRES_PORT=5432
# HTTP_PORT=80  # Only used by the optional Docker web profile.
# For a backend running outside Docker, set DATABASE_URL explicitly:
# DATABASE_URL=postgresql+psycopg://carbontrace:your_password@localhost:5432/carbontrace
# SMTP_HOST must also point to a reachable SMTP server outside Docker.
