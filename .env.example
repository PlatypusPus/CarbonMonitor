# CarbonTrace: copy to .env and replace the password and JWT secret.
# Default setup: Docker backend and PostgreSQL, Gmail SMTP for email; Vite on port 5173.
# Never commit .env. See docs/setup.md for installation and real email delivery.

ENVIRONMENT=development

# Database credentials. Docker Compose builds DATABASE_URL from these values.
POSTGRES_USER=carbontrace
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=carbontrace

# Generate a random secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Browser URL used in verification and invitation emails.
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email delivery via Gmail SMTP. Use a Gmail App Password, not your normal
# password: https://myaccount.google.com/apppasswords (needs 2-Step Verification).
# SMTP_FROM must use the same address as SMTP_USERNAME.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM="CarbonTrace <you@gmail.com>"
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=replace_with_gmail_app_password
SMTP_STARTTLS=true
SMTP_SSL=false

# Local-only alternative: Mailpit captures mail at http://localhost:8025 and
# sends nothing out. Use these instead of the Gmail values above:
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM="CarbonTrace <noreply@carbontrace.local>"
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false

# Optional overrides (defaults shown):
# POSTGRES_PORT=5432
# HTTP_PORT=80  # Only used by the optional Docker web profile.
# For a backend running outside Docker, set DATABASE_URL explicitly:
# DATABASE_URL=postgresql+psycopg://carbontrace:your_password@localhost:5432/carbontrace
# SMTP_HOST must also point to a reachable SMTP server outside Docker.
